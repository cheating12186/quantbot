# Optional: deterministic agents work without an LLM. Never commit real keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DATABASE_URL=sqlite:///./quantpilot.db

# oanda | yfinance | synthetic | auto (auto falls back to clearly labelled synthetic data)
DATA_PROVIDER=auto
ALLOW_SYNTHETIC_FALLBACK=true
# News providers (optional). `auto` = Finnhub (when FINNHUB_API_KEY is set) with yfinance fallback;
# `finnhub` = Finnhub only; `yfinance` = Yahoo only (no key, best-effort); `none` = explicit UNAVAILABLE.
NEWS_PROVIDER=auto
# Preferred, provider-specific key (https://finnhub.io — free tier: 60 calls/minute).
# US equities via /company-news; forex via the general forex category feed.
FINNHUB_API_KEY=
# Legacy alias for FINNHUB_API_KEY. Ignored when FINNHUB_API_KEY is set. If this key
# belongs to a different service, leave it empty and use FINNHUB_API_KEY.
NEWS_API_KEY=
# Cache TTL (seconds) for provider responses; 0 disables caching. Default 300.
NEWS_CACHE_TTL_SECONDS=300

# Optional read-only OANDA practice candles and quotes. Never use the live environment.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
PAPER_ONLY=true
API_HOST=0.0.0.0
API_PORT=8000

# Optional autopilot (paper-only). GET /api/v1/cron/tick runs one full agent cycle.
# AUTOPILOT_SYMBOL=EUR_USD
# AUTOPILOT_TIMEFRAME=1h
# AUTOPILOT_OBJECTIVE=Run the complete multi-agent workflow; trade only when every deterministic control passes.
# AUTOPILOT_EXECUTE=true
# CRON_SECRET=  # set to require Vercel's Authorization: Bearer header on cron calls
